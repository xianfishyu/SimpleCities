{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "godot": {
      "type": "local",
      "command": ["npx", "-y", "@satelliteoflove/godot-mcp"],
      "enabled": true,
      "timeout": 15000
    },
    "godot-minimal": {
      "type": "local",
      "command": ["npx", "-y", "@ryanmazzolini/minimal-godot-mcp@0.1.6"],
      "enabled": true,
      "timeout": 15000,
      "environment": {
        "GODOT_WORKSPACE_PATH": "D:/Code/GodotProject/simple-cities"
      }
    },
    "roslyn-codelens": {
      "type": "local",
      "command": ["roslyn-codelens-mcp", "D:/Code/GodotProject/simple-cities/SimpleCities.sln"],
      "enabled": true,
      "timeout": 120000
    }
  }
}

; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="SimpleCities"
run/main_scene="uid://baxamkfym8atd"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=144
config/icon="res://icon.svg"
run/main_scene.qa="res://tests/godot/exported_save_runtime_contract.tscn"

[autoload]

ImGuiRoot="*uid://dugmpnsxaagba"
SaveManager="*res://Scripts/Core/SaveManager.cs"
InputBindingManager="*res://Scripts/Core/InputBindingManager.cs"
MCPGameBridge="res://addons/godot_mcp/game_bridge/mcp_game_bridge.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[dotnet]

project/assembly_name="SimpleCities"

[editor]

movie_writer/movie_file="D:/Code/GodotProject/simplecities/video.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/imgui-godot/plugin.cfg", "res://addons/godot_mcp/plugin.cfg")

[godot_mcp]

bind_mode=0
custom_bind_ip=""
port_override_enabled=true
port_override=6550

[gui]

theme/default_font_multichannel_signed_distance_field=true

